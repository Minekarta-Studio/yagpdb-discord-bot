# Enter these six variables in the Dokploy Compose Environment tab.
# Do not commit real tokens, secrets, or passwords to Git.
YAGPDB_OWNER=YOUR_DISCORD_USER_ID
YAGPDB_BOTTOKEN=YOUR_NEW_BOT_TOKEN
YAGPDB_CLIENTID=YOUR_NEW_APPLICATION_ID
YAGPDB_CLIENTSECRET=YOUR_NEW_OAUTH_CLIENT_SECRET
YAGPDB_HOST=bot.example.com
YAGPDB_DB_PASSWORD=GENERATE_A_LONG_RANDOM_HEX_PASSWORD
